# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# DB_ENGINE=sqlite uses a local db.sqlite3 file (default, no other DB_* vars needed).
# Set DB_ENGINE=postgres and fill in the rest to use PostgreSQL instead.
DB_ENGINE=sqlite
DB_NAME=rivyn
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Anthropic API (used for AI ticket triage)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
